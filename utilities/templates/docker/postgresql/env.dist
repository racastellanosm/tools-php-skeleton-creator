# Application
APP_NAME=project_name_placeholder
APP_ENV=dev
APP_SECRET=
APP_MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
APP_DATABASE_DSN=postgresql://local:localpasswd@postgresql:5432/project_name_placeholder?serverVersion=17&charset=utf8
APP_DEBUG=1
APP_RUNTIME=Runtime\RoadRunnerSymfonyNyholm\Runtime
APP_LOG_LEVEL=info
APP_DEFAULT_URI=http://localhost

# PostgreSQL
POSTGRES_USER=local
POSTGRES_PASSWORD=localpasswd
POSTGRES_DB=project_name_placeholder

# RoadRunner
APP_NUM_WORKERS=1
APP_MAX_JOBS=100
APP_MAX_WORKER_MEMORY=128

# Development Variables
PHP_IDE_CONFIG=serverName=$APP_NAME.cli